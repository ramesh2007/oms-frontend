# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  HalaMama Dashboard — Environment Configuration                     ║
# ║                                                                     ║
# ║  HOW TO USE:                                                        ║
# ║  1. Copy this file and rename it to ".env" (remove the .example)    ║
# ║  2. Fill in your ERPNext server details below                       ║
# ║  3. Restart your dev server (npm run dev) after changes             ║
# ║                                                                     ║
# ║  IMPORTANT: Never commit the .env file to Git!                      ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ─── DATA SOURCE TOGGLE ──────────────────────────────────────────────────
# Set to "true"  → App uses built-in demo/dummy data (no server needed)
# Set to "false" → App connects to your ERPNext server via API
VITE_USE_MOCK_DATA=true

# ─── ERPNEXT SERVER CONNECTION ───────────────────────────────────────────
# Your API server base URL
# Example: https://delivery-management.hmws.qatar123.com/public
VITE_API_URL_DEV=https://delivery-management.hmws.qatar123.com/public
VITE_ERPNEXT_URL=https://delivery-management.hmws.qatar123.com/public

# ─── ERPNEXT API AUTHENTICATION ──────────────────────────────────────────
# Generate these in ERPNext: User → API Access → Generate Keys
# The API Key is like a username, the API Secret is like a password
VITE_ERPNEXT_API_KEY=
VITE_ERPNEXT_API_SECRET=
